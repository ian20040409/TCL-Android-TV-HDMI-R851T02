<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 強制鎖定純黑 Dark Mode 主題：
         1. 視窗起手背景 (windowBackground) 即為純黑 #000000，冷啟動絕不閃現白底或灰底。
         2. forceDarkAllowed=false，防止系統自動反轉顏色。
         3. 繼承系統 DeviceDefault 全螢幕深色主題，0 外部庫依賴。 -->
    <style name="Theme.PureBlackDarkOnly" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- 防止系統在冷啟動 / 切換時對視窗截圖並閃現預覽幀 -->
        <item name="android:windowDisablePreview">true</item>
        <!-- 確保不顯示 ActionBar title bar，減少一次 measure pass -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <!-- 關閉視窗轉場動畫：Activity 切換 0ms 瞬間完成，不觸發額外 GPU 合成幀 -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- HDMI 直通播放專用主題：
         標準全螢幕深色底，SurfaceView 硬體直通打洞渲染，不使用透明視窗防止下層 Activity 阻擋與系統誤判浮動視窗 -->
    <style name="Theme.HdmiViewer" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- OOBE Checkmark 隱藏樣式：無 parent，直接定義寬高為 0dp 且隱藏 -->
    <style name="OobeGuidedActionItemCheckmark">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- OOBE 開箱設定引導專用主題：純黑、無 Radio Button Checkmark -->
    <style name="Theme.Oobe" parent="Theme.Leanback.GuidedStep">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="guidedActionItemCheckmarkStyle">@style/OobeGuidedActionItemCheckmark</item>
        <item name="guidedActionsElevation">0dp</item>
    </style>

    <!-- 原生 Leanback 集中設定抽屜主題（僅 SettingsActivity 使用：左邊透明透出首頁，右邊側邊欄） -->
    <style name="Theme.Settings" parent="Theme.Leanback.GuidedStep">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="guidedActionItemCheckmarkStyle">@style/OobeGuidedActionItemCheckmark</item>
        <item name="guidedActionsElevation">0dp</item>
    </style>

    <!-- 子設定頁面專用主題（GuidedStepSupportFragment：AppMode, ButtonMapper, Shizuku）純黑底 -->
    <style name="Theme.GuidedStepSettings" parent="Theme.Leanback.GuidedStep">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="guidedActionItemCheckmarkStyle">@style/OobeGuidedActionItemCheckmark</item>
        <item name="guidedActionsElevation">0dp</item>
    </style>
</resources>
