<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- 開機廣播權限（API 33 以下自動授予；API 33+ 安裝時自動批准） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_LOGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 讀取 CEC Active Routing Path 必需權限（需透過 ADB shell pm grant 授予） -->
    <uses-permission android:name="android.permission.DUMP" />
    <!-- API 34+ requires a declared foreground-service type before startForeground(). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ (API 30+) Launcher 查詢所有已安裝 TV / 手機 App 必備權限 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- 支援從 App 清單長按解除安裝應用程式 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Shizuku API Permission -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.tcl.settings" />
        <package android:name="com.android.tv.settings" />
        <package android:name="com.android.settings" />
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.TV_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ACCESSIBILITY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TclHdmiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PureBlackDarkOnly">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:icon="@mipmap/ic_launcher"
            android:theme="@style/Theme.PureBlackDarkOnly"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing">

            <!-- 作為 TV Leanback Launcher（遙控器 Home 鍵） -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- 作為通用 Home Launcher（開機自動啟動） -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

        <!-- App 清單啟動器：無任何 intent-filter，只由 MainActivity 顯式呼叫 -->
        <activity
            android:name=".applist.AppListActivity"
            android:exported="false"
            android:theme="@style/Theme.PureBlackDarkOnly"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing" />

        <!-- Button Mapper 專屬設定頁面：按鍵映射與無障礙權限 -->
        <activity
            android:name=".settings.ButtonMapperSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.GuidedStepSettings"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing" />

        <!-- 集中設定頁面：管理 Launcher 全部偏好與系統捷徑 -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Settings"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing" />

        <activity
            android:name=".cec.CecDebugActivity"
            android:exported="false"
            android:theme="@style/Theme.PureBlackDarkOnly"
            android:screenOrientation="landscape" />

        <!-- App 模式專屬設定頁面：獨立管理 App 模式偏好與自動啟動 -->
        <activity
            android:name=".settings.AppModeSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.GuidedStepSettings"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing" />

        <!-- Shizuku API 檢測與 APK 下載管理頁面 -->
        <activity
            android:name=".settings.ShizukuSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.GuidedStepSettings"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku ContentProvider：Shizuku 服務與彈出授權視窗溝通必備 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- 首次開箱設定引導精靈 (OOBE) -->
        <activity
            android:name=".settings.OobeActivity"
            android:exported="false"
            android:theme="@style/Theme.Oobe"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing" />



        <!-- 原生硬體 HDMI 直通播放器：TvView 渲染，完全脫離 com.tcl.tv -->
        <activity
            android:name=".HdmiViewerActivity"
            android:exported="true"
            android:theme="@style/Theme.HdmiViewer"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTask">

            <!-- 系統標準 Passthrough 視訊意圖接管 (無 MIME Type 與含系統 TvProvider MIME Type) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:host="android.media.tv"
                    android:pathPrefix="/passthrough" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:host="android.media.tv"
                    android:pathPrefix="/passthrough"
                    android:mimeType="vnd.android.cursor.item/channel" />
                <data
                    android:scheme="content"
                    android:host="android.media.tv"
                    android:pathPrefix="/passthrough"
                    android:mimeType="vnd.android.cursor.dir/channel" />
            </intent-filter>

        </activity>

        <!-- 開機 / 睡眠喚醒自動啟動 Receiver -->

        <receiver
            android:name=".BootAndWakeReceiver"
            android:exported="true">
            <intent-filter>
                <!-- 系統完整開機 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 鎖定狀態下開機（Direct Boot） -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- TCL / 高通快速開機路徑 -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- 螢幕保護 / 待機結束 → TV 從睡眠喚醒 -->
                <action android:name="android.intent.action.DREAMING_STOPPED" />
                <!-- CEC 喚醒 -->
                <action android:name="com.tcl.action.cec.MSG_VIEW_ON" />
            </intent-filter>
        </receiver>

        <!-- 無障礙服務：確保待機休眠喚醒常駐與 Home 鍵強效拉回（選用開啟） -->
        <service
            android:name=".WakeAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:description="@string/accessibility_service_description"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service android:name=".cec.CecLogReaderService"
                 android:exported="false"
                 android:foregroundServiceType="dataSync" />

    </application>

</manifest>
