<?xml version="1.0" encoding="utf-8"?>
<!-- App 抽屜全螢幕頁面 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingEnd="48dp">

    <!-- 頂部標題與電視專屬操作按鈕列 -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_page_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_list_title"
                android:textColor="#E0E0E0"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_page_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/app_list_hint"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- 電視暗色沉浸式按鈕 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/btn_settings"
            android:textColor="#E2E8F0"
            app:backgroundTint="@color/tv_button_bg_color"
            app:strokeColor="@color/tv_button_stroke_color"
            app:strokeWidth="1.5dp"
            app:cornerRadius="20dp"
            app:icon="@drawable/settings_48px"
            app:iconTint="#94A3B8"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_hdmi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_hdmi_selector"
            android:textColor="#E2E8F0"
            app:backgroundTint="@color/tv_button_bg_color"
            app:strokeColor="@color/tv_button_stroke_color"
            app:strokeWidth="1.5dp"
            app:cornerRadius="20dp"
            app:icon="@drawable/settings_input_hdmi_24px"
            app:iconTint="#94A3B8"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_batch_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@string/btn_batch_action"
            android:textColor="#E2E8F0"
            app:backgroundTint="@color/tv_button_bg_color"
            app:strokeColor="@color/tv_button_stroke_color"
            app:strokeWidth="1.5dp"
            app:cornerRadius="20dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel"
            android:textColor="#E2E8F0"
            app:backgroundTint="@color/tv_button_bg_color"
            app:strokeColor="@color/tv_button_stroke_color"
            app:strokeWidth="1.5dp"
            app:cornerRadius="20dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 原生 Material ChipGroup 分類過濾標籤列 -->
    <HorizontalScrollView
        android:id="@+id/hsv_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <!-- 開機自動啟動倒數提示橫幅 -->
    <TextView
        android:id="@+id/tv_auto_open_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="#0F172A"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="#38BDF8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 載入中指示器 -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="60dp"
        android:visibility="gone" />

    <!-- 空清單提示 -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:gravity="center"
        android:text="@string/app_list_empty"
        android:textColor="#64748B"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- 電視網格列表：設定固定欄數，允許邊緣不被裁切 -->
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/vgv_apps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingBottom="36dp"
        app:numberOfColumns="5" />

</LinearLayout>
